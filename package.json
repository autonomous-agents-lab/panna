{
  "name": "panna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A digital book for everyone. Scaffolded by the first story of Epic 1.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
