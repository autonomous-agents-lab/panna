{
  "name": "panna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A digital book for everyone. Scaffolded by the first story of Epic 1.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:build": "next build && vitest run --config vitest.build.config.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.19",
    "@rolldown/binding-darwin-x64": "1.2.19",
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
