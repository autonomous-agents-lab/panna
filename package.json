    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
