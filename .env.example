# Copy to .env.local (git-ignored) and edit as needed: cp .env.example .env.local
# Every variable here is read and validated by src/config. The app settings have working
# defaults, so the shell also runs without .env.local. An invalid value stops `next dev`/`next build`
# with an error naming the variable. These are public (NEXT_PUBLIC_*) values, never secrets.
#
# Deployed values live only in Netlify (site panna-book → Site configuration → Environment
# variables), never in the repo. Each variable below says whether it is set there.
# The Supabase service-role key may only ever go in Netlify's server-side environment: never in
# this file, never in client code and never with a NEXT_PUBLIC_ prefix.

# Display name of the app, used in the page title and header. Non-empty text. Default: Panna
# Set in Netlify.
NEXT_PUBLIC_APP_NAME=Panna

# Public base URL of the site, used for metadata, canonical/Open Graph URLs and the auth callback
# that magic links and Google return to (<site URL>/auth/callback).
# Absolute URL. Default: http://localhost:3000 (local development only).
# Not set in Netlify: netlify.toml maps it from Netlify's production URL, so Deploy Previews
# use the production canonical URL. A value set in Netlify (e.g. a custom domain) wins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flag: play a sound when a page turns in the reader. true/false. Default: true
NEXT_PUBLIC_FEATURE_PAGE_TURN_SOUND=true

# Largest image a writer may upload, in megabytes. Positive whole number. Default: 5
NEXT_PUBLIC_MAX_IMAGE_UPLOAD_MB=5

# --- Supabase ---
# No defaults: these are checked only when a Supabase client is created, so pages that don't
# use Supabase still work without them. Get the local values from `npx supabase status`
# (see "Local Supabase" in the README). The anon key is public by design; RLS protects the data.

# Supabase API URL. Absolute URL. Local stack: http://127.0.0.1:54321
# Set in Netlify (the hosted project).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (public) key. Replace the placeholder with the "anon key" / publishable key
# that `npx supabase status` prints.
# Set in Netlify by the Netlify–Supabase integration, before the auth work in Epic 2.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status

# --- Read only by the Supabase CLI, never by the app or client code. ---
# supabase/config.toml turns Google sign-in on with env(...) references to these. The CLI doesn't
# read the app's .env.local, so export them in your shell before `npx supabase start`. Unset, the
# CLI keeps the env(...) text as a placeholder, so the stack still starts and magic links work;
# only real Google sign-in needs real values.
# Never commit real credentials. Not set in Netlify: the hosted project's Google keys live in the
# Supabase dashboard.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=placeholder-google-client-id
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=placeholder-google-secret

# --- End-to-end tests only. ---
# Local Supabase's mail inbox (Mailpit), where the magic-link tests read their emails.
# Default: http://127.0.0.1:54324 (the [local_smtp] port in supabase/config.toml).
# E2E_MAILPIT_URL=http://127.0.0.1:54324

# --- Server-only values, read by src/config/server.ts and never sent to the browser. ---

# Version reported by /api/health: a commit SHA (7 to 40 hex characters); anything else is
# ignored in favour of the package.json version. Not set in Netlify: netlify.toml maps
# Netlify's commit onto it at build time.
# APP_VERSION=abc1234

# Turns on /test-only/* routes, which exist only for the end-to-end tests (Playwright sets it
# for the server it starts). true/false. Default: false.
# Must never be set in Netlify, in production or in deploy previews.
ENABLE_TEST_ROUTES=false
